# Copy this file to .env and fill in your values. .env is git-ignored.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API (the Next.js site)
CORS_ORIGIN=http://localhost:3000

# MySQL (local install: MySQL Server 8.0, Windows service "MySQL80", port 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Quote the password if it contains # or spaces, e.g. DB_PASSWORD="p#ss word"
DB_PASSWORD="your_mysql_password"
DB_NAME=shaktipath
# Set to true for cloud MySQL that requires TLS (TiDB Cloud, Aiven and similar hosts)
DB_SSL=false
# Alternative to the DB_* fields: one connection URL, as most cloud providers give you
# DATABASE_URL=mysql://user:password@host:3306/shaktipath

# Development convenience: when the database cannot be reached, serve the built-in sample
# content (the same records as db/seed.sql) instead of failing. Set to false in production.
USE_SAMPLE_FALLBACK=true
